#!/bin/bash
#SBATCH --job-name=hyb_aipog_20260406
#SBATCH --account=def-rsadve
#SBATCH --array=0-2
#SBATCH --cpus-per-task=8
#SBATCH --mem=24G
#SBATCH --time=07:00:00
#SBATCH --output=hyb_aipog_20260406-%A_%a.out
#SBATCH --error=hyb_aipog_20260406-%A_%a.err

set -euo pipefail

cd /home/rsadve1/scratch/GRAND_AI

ITS=(8 15 25)
IT="${ITS[$SLURM_ARRAY_TASK_ID]}"

export STAGE1_ITERS="$IT"
export RESULTS_DIR="results/run_hybrid_ldpc_grand_aipog_20260406_it$(printf '%02d' "$IT")_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"

export OMP_NUM_THREADS="$SLURM_CPUS_PER_TASK"
export LDPC_GRAND_NUM_THREADS="$SLURM_CPUS_PER_TASK"
export NUMBA_NUM_THREADS="$SLURM_CPUS_PER_TASK"
export TF_INTRA_OP=1
export TF_INTER_OP=1
export ENABLE_TF_RUNTIME_CONFIG=1
export USE_GPU=0

export RNG_SEED_GLOBAL=20260406

export TARGET_FRAME_ERRORS=100
export MAX_FRAMES=150000
export CALIB_TARGET_FAILED_FRAMES=700
export CALIB_MAX_FRAMES=260000

export EVAL_SNR_SWEEP="6.0,6.5,7.0,7.5,8.0"
export CALIB_SNR_SWEEP="5.75,6.25,6.75,7.25"

export AI_TEACHER_HIDDEN=96
export AI_TEACHER_EPOCHS=28
export AI_STUDENT_EPOCHS=22
export AI_BATCH_SIZE=4096
export AI_TEACHER_LR=0.01
export AI_STUDENT_LR=0.020
export AI_DISTILL_TEMP=2.5

export GRAND_MAX_PATTERNS=200000
export GRAND_TX_INFO_POOL=56
export GRAND_PUNCTURED_INFO_POOL=24
export GRAND_TX_PARITY_POOL=16
export GRAND_SINGLE_POOL=96
export GRAND_MAX_SUPPORT_BITS=160
export GRAND_PROB_MIN=1.0e-4
export GRAND_PROB_MAX=0.49

export SIONNA_TDL_MODEL=B
export SIONNA_TDL_DELAY_SPREAD_S=6.0e-8
export SIONNA_TDL_MIN_SPEED=0.2
export SIONNA_TDL_MAX_SPEED=1.0
export SIONNA_CFO_HZ=4.0
export SIONNA_CSI_MODE=nr_imperfect
export SIONNA_CSI_BLOCK_SC=16
export SIONNA_CSI_PILOT_STRIDE=16
export SIONNA_CSI_SMOOTH_PILOTS=2
export SIONNA_CSI_PHASE_DRIFT_STD_DEG=0.6
export SIONNA_CSI_AMP_RIPPLE_DB=0.25
export SIONNA_CSI_DELAY_BIAS_NS=2.0

python hybrid_ldpc_grand_aipog_20260406.py "$RESULTS_DIR"
